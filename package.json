{
  "name": "risksir",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/console/tsconfig.json && tsc --noEmit -p apps/site/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/console/tsconfig.json && tsc --noEmit -p apps/site/tsconfig.json && eslint . && vitest run",
    "test:live": "node scripts/live-guard.mjs",
    "demo:smoke": "tsx --env-file=.env apps/gate/src/cli/smoke.ts",
    "demo:reset": "tsx apps/gate/src/cli/reset.ts",
    "demo:seed": "tsx apps/gate/src/cli/seed.ts",
    "demo:failure": "tsx --env-file=.env apps/gate/src/cli/demo-failure.ts",
    "wallet:status": "tsx --env-file=.env apps/gate/src/cli/wallet-status.ts",
    "demo:pass": "tsx --env-file=.env apps/gate/src/cli/demo.ts pass",
    "demo:block": "tsx --env-file=.env apps/gate/src/cli/demo.ts block",
    "demo:alt": "tsx --env-file=.env apps/gate/src/cli/demo.ts v2",
    "demo:v2": "tsx --env-file=.env apps/gate/src/cli/demo-v2.ts",
    "trace:export": "tsx apps/gate/src/cli/export-trace.ts",
    "verify:tx": "tsx --env-file=.env apps/gate/src/cli/verify-tx.ts",
    "reconcile": "tsx --env-file=.env apps/gate/src/cli/reconcile.ts",
    "seed": "tsx apps/gate/src/cli/seed.ts",
    "export:site": "tsx scripts/export-site-data.ts",
    "build:site": "pnpm --filter @risksir/site build",
    "dev:site": "pnpm --filter @risksir/site dev",
    "owner-api": "tsx --env-file=.env apps/gate/src/cli/owner-api.ts",
    "owner-api:live": "tsx --env-file=.env apps/gate/src/cli/owner-api-live.ts",
    "build:console": "pnpm --filter @risksir/console build",
    "dev:console": "pnpm --filter @risksir/console dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
