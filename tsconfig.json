{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src",
    "scripts/*.ts",
    "packages/*/test",
    "apps/gate/src",
    "apps/gate/test",
    "apps/seller/src",
    "apps/seller/test",
    "test",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
