# Risksir environment. Copy to .env and fill in. Never commit .env.
# Agents check which variables are set with: bash scripts/env-status.sh (names only, never values)

# Intercepta (W3A) sandbox API key from the sponsor. Required for live screening (M-003+).
INTERCEPTA_API_KEY=
# Base URL of the W3A public API (confirm in docs.web3antivirus.io).
INTERCEPTA_BASE_URL=

# Buyer payer wallet: a FRESH Base Sepolia test wallet only. It must never have held mainnet funds.
# Fund it with a little Base Sepolia ETH and test USDC. Required for live payments (M-004+).
PAYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# x402 test facilitator (confirm in docs.x402.org).
X402_FACILITATOR_URL=https://x402.org/facilitator

# Merchant payTo addresses (20-byte EVM, receive-only; no merchant keys in this repo).
# SAFE: an acceptable comparator address.
SELLER_PAY_TO_SAFE=
# RISKY: the sponsor-provided known-risk MAINNET address. Screened live, never paid.
SELLER_PAY_TO_RISKY=
# ALT (optional): a third, never-paid address for the policy v2 "first-time counterparty" demo.
SELLER_PAY_TO_ALT=

# Owner console bearer token (hackathon-grade, but real). Any long random string.
OWNER_CONSOLE_TOKEN=
